gemini_api_key=
unpaywall_email=
ncbi_email=
elsevier_api_key=

# Optional settings
gemini_model=gemini-3.5-flash
llm_workers=1
gemini_service_tier=
gemini_max_retries=12
gemini_retry_backoff=2
gemini_retry_backoff_cap=60

# Use 0 to disable a cap. Keep these conservative if cost is a concern.
paper_char_cap=0
supplement_char_cap=80000

# R GEO extraction is more stable with one worker on macOS.
geo_r_workers=1
max_gsms_per_gse=
ids_file=
